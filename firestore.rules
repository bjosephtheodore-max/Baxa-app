rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin(companyId) {
      return signedIn() && request.auth.uid == companyId;
    }

    // Staff = users/{uid} pointe vers cette entreprise ET son document
    // companies/{companyId}/staff/{uid} existe encore avec isActive == true.
    // Ce 2e critère est ce qui coupe réellement l'accès dès qu'un membre
    // est retiré depuis "Mon équipe" — avant, seul le premier critère
    // comptait, donc un membre retiré gardait un accès complet.
    function isStaff(companyId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && u.get('role', '') == 'staff'
        && u.get('companyId', '') == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId)/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/staff/$(request.auth.uid)).data.get('isActive', false) == true;
    }

    function hasAccess(companyId) {
      return isAdmin(companyId) || isStaff(companyId);
    }

    // Sous-collections d'entreprise qui ont leurs PROPRES règles ci-dessous :
    // exclues du bloc générique (en bas de match /companies), sinon ses
    // droits s'ajouteraient aux leurs (les règles Firestore s'additionnent).
    // Toute nouvelle sous-collection dotée de règles dédiées doit être
    // ajoutée ici.
    function hasDedicatedRules(sub) {
      return sub in ['queues', 'reservations', 'invitations', 'staff',
        'notificationsHistory', 'companyNotifications'];
    }

    match /companies/{companyId} {
      allow read: if true;
      // Création de la fiche : UNIQUEMENT côté serveur (Cloud Function
      // `companyAccount`, qui vérifie que le compte n'est ni client, ni
      // membre d'équipe, ni anonyme). L'app ne crée plus jamais de fiche.
      // Mise à jour (nom, téléphone, adresse…) : l'admin et le staff actif,
      // SAUF le résumé « recherche » tenu par le serveur (nombre de files,
      // fermeture visible des clients) — sinon une structure pourrait
      // s'afficher ouverte alors qu'elle est fermée.
      allow update: if hasAccess(companyId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['queueCount', 'closedNow', 'reopenAt',
            'closurePlannedFor', 'createdAt']);
      allow delete: if isAdmin(companyId);

      // ── Tout ce qui touche aux places est écrit UNIQUEMENT côté serveur
      // (Admin SDK, qui contourne ces règles) : réservations client
      // (`booking`), réservations gérées par la structure
      // (`companyBooking`), plages et créneaux (`companySchedule`), et la
      // maintenance de nuit. L'app ne fait plus que LIRE : un compteur ne
      // peut plus être faussé, ni une place prise sans vérification.

      // Créneaux : lecture publique.
      match /queues/{queueId}/slots/{slotId} {
        allow read: if true;
        allow write: if false;
      }

      // File d'attente : lecture publique. Création, suppression et
      // fermetures passent par le serveur (limite de 5 files, plages et
      // réservations vérifiées). L'admin ne modifie depuis l'app que ses
      // réglages simples, avec des valeurs plausibles.
      match /queues/{queueId} {
        allow read: if true;
        allow create, delete: if false;
        allow update: if isAdmin(companyId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'maxAdvanceDays', 'reservationDeadlineMinutes',
              'allowMultiplePerPlage'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.maxAdvanceDays is int
          && request.resource.data.maxAdvanceDays >= 1
          && request.resource.data.maxAdvanceDays <= 7
          && request.resource.data.reservationDeadlineMinutes is int
          && request.resource.data.reservationDeadlineMinutes >= 0
          && request.resource.data.reservationDeadlineMinutes <= 60
          && request.resource.data.get('allowMultiplePerPlage', false) is bool;
      }

      // Plages horaires (config) : lecture publique, écriture serveur.
      match /queues/{queueId}/timeSlots/{timeSlotId} {
        allow read: if true;
        allow write: if false;
      }

      // Places libres par jour : lecture publique (page créneaux du
      // client), écriture serveur.
      match /queues/{queueId}/dailyStats/{dateStr} {
        allow read: if true;
        allow write: if false;
      }

      // Réservations (contiennent nom et e-mail du client).
      // Lecture : l'entreprise (admin + staff actif) et le client concerné
      // UNIQUEMENT. Les requêtes client doivent donc filtrer sur
      // customerId == son uid (c'est le cas partout dans l'app).
      // Écriture : UNIQUEMENT côté serveur — le client via `booking`
      // (quota, places, règles d'écart), la structure via `companyBooking`
      // (place vérifiée au moment d'écrire, droits du membre : un membre
      // ne retire que ses propres inscriptions).
      match /reservations/{reservationId} {
        allow read: if hasAccess(companyId) || (
          signedIn() && resource.data.get('customerId', '') == request.auth.uid
        );
        allow write: if false;
      }

      // Invitations : gérées par l'entreprise. La vérification d'un code et
      // sa consommation se font côté serveur (Cloud Functions checkInviteCode
      // / joinTeamWithCode) — plus aucune écriture ouverte aux inconnus.
      match /invitations/{inviteId} {
        allow read, create, update, delete: if hasAccess(companyId);
      }

      // Membres du staff : l'adhésion (création / réactivation) passe
      // UNIQUEMENT par la Cloud Function joinTeamWithCode, qui vérifie le
      // code et la limite de membres — un client ne peut donc plus se
      // déclarer membre tout seul. Retirer un membre reste réservé à l'admin ;
      // le membre actif peut seulement mettre à jour sa dernière activité.
      // Lecture : l'équipe (admin + membres actifs), et chaque membre sa
      // propre fiche — même retiré, c'est ainsi que l'app détecte le retrait.
      match /staff/{uid} {
        allow read: if hasAccess(companyId)
          || (signedIn() && request.auth.uid == uid);
        allow update: if isAdmin(companyId) || (
          signedIn() && request.auth.uid == uid
          && resource.data.get('isActive', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        );
        allow delete: if isAdmin(companyId);
      }

      // Historique de notifications : usage interne entreprise, jamais public
      // (ancienne collection — remplacée par companyNotifications ci-dessous,
      // conservée le temps que le nettoyage serveur purge les vieux docs).
      match /notificationsHistory/{notifId} {
        allow read, write: if hasAccess(companyId);
      }

      // Journal unifié des notifications entreprise (admin + staff). Écrit
      // UNIQUEMENT côté serveur (Cloud Functions, Admin SDK). L'app peut lire
      // et supprimer (glisser pour effacer / tout supprimer), jamais créer.
      // Chacun ne voit QUE ses entrées : l'admin celles d'audience "admin",
      // un membre celles qui portent son staffId. Les requêtes de l'app
      // filtrent donc sur ces champs (sinon Firestore les refuse).
      match /companyNotifications/{notifId} {
        allow read, delete: if
          (isAdmin(companyId) && resource.data.audience == 'admin')
          || (signedIn()
              && resource.data.get('staffId', '') == request.auth.uid
              && isStaff(companyId));
        allow create, update: if false;
      }

      // Tout AUTRE sous-arbre (futures données) : PRIVÉ PAR DÉFAUT —
      // lecture et écriture réservées à l'entreprise (admin + staff actif).
      // Ce qui doit être public est déclaré explicitement plus haut (files,
      // plages, créneaux, places par jour). Suppression volontairement
      // absente : elle doit être déclarée collection par collection.
      // Les sous-collections dotées de règles dédiées en sont exclues (voir
      // hasDedicatedRules), pour que seules leurs propres règles comptent.
      // (Nom de sous-collection testé via {sub} et non via le chemin
      // complet : c'est la seule forme que Firestore sait évaluer sur une
      // requête de LISTE.)
      match /{sub}/{rest=**} {
        allow read, create, update: if hasAccess(companyId)
          && !hasDedicatedRules(sub);
      }
    }

    // Lecture transversale pour les collectionGroup queries du CLIENT (ses
    // réservations dans toutes les entreprises : accueil, « Mes
    // réservations »…) : uniquement SES réservations — la requête doit
    // filtrer sur customerId == son uid, sinon Firestore la refuse.
    match /{path=**}/reservations/{reservationId} {
      allow read: if signedIn()
        && resource.data.get('customerId', '') == request.auth.uid;
    }

    // Les notifications d'annulation par une entreprise
    // (customers/{id}/notifications) sont écrites UNIQUEMENT côté serveur,
    // par la Cloud Function `onReservationCancelledByCompany` (Admin SDK,
    // contourne ces règles) — aucune règle spécifique n'est donc ajoutée
    // ici pour l'entreprise. Le client garde son accès complet habituel à
    // son propre arbre `customers/{son propre uid}` via la règle générique
    // ci-dessous (inchangée).
    match /customers/{customerId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == customerId;
    }

    // Profil : chacun gère le sien, SAUF les compteurs de réservations —
    // quota du jour (dailyBookingCount / lastBookingDate) et total
    // (totalReservations) — tenus uniquement par la Cloud Function
    // `booking` : sinon la limite quotidienne serait contournable.
    // Pas de suppression côté client (l'app n'en fait pas) : supprimer puis
    // recréer son profil remettrait le quota à zéro.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys()
          .hasAny(['dailyBookingCount', 'lastBookingDate',
            'totalReservations']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['dailyBookingCount', 'lastBookingDate',
            'totalReservations']);

      match /favorites/{favId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /recentCompanies/{companyId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Demande de suppression de compte entreprise (1 doc par entreprise, id = companyId).
    // Réservé à l'admin (pas au staff). L'admin crée sa demande et peut la
    // supprimer (= annuler) pendant le délai de grâce ; le passage à
    // `approved` / `completed` est fait côté serveur uniquement (Admin SDK).
    match /deletionRequests/{companyId} {
      allow read, create, delete: if isAdmin(companyId);
    }

    // Annuaire de recherche par pays : copie des champs publics de
    // `companies` (déjà lisibles par tous), tenue à jour uniquement par
    // les Cloud Functions. `searchDirectoryMeta` n'a aucune règle →
    // inaccessible aux clients.
    match /searchDirectory/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Alertes internes plateforme (demandes de départ, etc.) — écrites
    // uniquement par les Cloud Functions (Admin SDK), consultées en console.
    // Aucun accès client.
    match /adminAlerts/{alertId} {
      allow read, write: if false;
    }
  }
}
